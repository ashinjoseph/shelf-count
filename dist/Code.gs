      <span class="ico">&#9906;</span>
      <input class="search" id="search" type="search" placeholder="Search name or barcode" aria-label="Search name or barcode" autocomplete="off">
      <button class="clearsearch" id="clearsearch" hidden aria-label="Clear search">&#10005;</button>
    </div>
    <div class="chips" id="chips" role="tablist" aria-label="Sections"></div>
  </div>

  <div class="banner" id="banner" hidden>
    <div class="txt"><strong id="banner-title"></strong><span id="banner-body"></span></div>
    <button id="banner-ok">Got it</button>
  </div>

  <div class="list" id="list"></div>

  <div class="bottombar">
    <div class="bar">
      <div class="n"><span id="scope-label"></span><span><b id="done">0</b> of <b id="total">0</b></span></div>
      <div class="track"><i id="trackfill" style="width:0%"></i></div>
    </div>
    <button class="sendbtn" id="send">Send now</button>
  </div>
</div>

<script>
(function(){
  "use strict";

  var KEY = 'shelfcount.v1';
  var FLUSH_EVERY = 15000;
  var MAX_BATCH = 150;

  var $ = function(id){ return document.getElementById(id); };
  var PRODUCTS = [], GROUPS = [], BY_KEY = {};
  var state = {who:'', code:'', counts:{}, outbox:{}, section:0, query:'', lastSync:0};
  var sending = false, retries = 0, retryTimer = null, hiddenAt = 0, booted = false;

  // ---- persistence -------------------------------------------------------
  // Written on every keystroke. This is what makes a suspended tab, a dead
  // battery or a walk out of signal survivable.
  var saveTimer = null;
  function persist(){
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function(){
      try {
        localStorage.setItem(KEY, JSON.stringify({
          who:state.who, code:state.code, counts:state.counts, outbox:state.outbox,
          section:state.section, lastSync:state.lastSync, roster:PRODUCTS
        }));
      } catch (e) {}
    }, 200);
  }
  function restore(){
    try {
      var s = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (!s) return null;
      state.who = s.who || ''; state.code = s.code || '';
      state.counts = s.counts || {}; state.outbox = s.outbox || {};
      state.section = s.section || 0; state.lastSync = s.lastSync || 0;
      return s.roster || null;
    } catch (e) { return null; }
  }

  // ---- server ------------------------------------------------------------
  function hasServer(){
    return typeof google !== 'undefined' && google.script && google.script.run;
  }

  function bootstrap(code, onOk, onErr){
    if (!hasServer()) { onErr({message:'NO_SERVER'}); return; }
    google.script.run
      .withSuccessHandler(onOk)
      .withFailureHandler(onErr)
      .rpcBootstrap(code);
  }

  function loadRoster(res){
    PRODUCTS = res.products.map(function(p, i){
      p.id = p.key || ('x' + i);
      return p;
    });
    GROUPS = [];
    BY_KEY = {};
    PRODUCTS.forEach(function(p){
      if (GROUPS.indexOf(p.group) === -1) GROUPS.push(p.group);
      BY_KEY[p.id] = p;
      // The sheet is the truth for anything this device has not touched, so a
      // counter who switches phones sees what has already been counted.
      if (!(p.id in state.counts) && p.stock !== '' && p.stock !== null) {
        state.counts[p.id] = {stock:p.stock, min:p.min, max:p.max, at:0};
      }
    });
    if (state.section >= GROUPS.length) state.section = 0;
  }

  // ---- outbox ------------------------------------------------------------
  function queued(){ return Object.keys(state.outbox); }

  function flush(){
    if (sending || !queued().length) { renderSync(); return; }
    if (!navigator.onLine || !hasServer()) { renderSync(); return; }

    var keys = queued().slice(0, MAX_BATCH);
    var stamps = {};
    var batch = keys.map(function(k){
      var e = state.outbox[k];
      stamps[k] = e.at;
      return {barcode:BY_KEY[k] ? BY_KEY[k].barcode : k, stock:e.stock, min:e.min, max:e.max, at:e.at, by:state.who};
    });

    sending = true;
    renderSync();

    google.script.run
      .withSuccessHandler(function(res){
        // Clear only what was actually sent, and only if it has not been
        // retyped while the request was in flight — otherwise the newer
        // number would be dropped without ever reaching the sheet.
        keys.forEach(function(k){
          if (state.outbox[k] && state.outbox[k].at === stamps[k]) delete state.outbox[k];
        });
        state.lastSync = Date.now();
        sending = false; retries = 0;
        persist(); renderSync();
        if (res && res.unmatched && res.unmatched.length) {
          say('Not in the list', res.unmatched.length + ' item' +
              (res.unmatched.length === 1 ? '' : 's') +
              ' could not be matched to the sheet. They are still saved here — tell the manager.');
        }
        if (queued().length) flush();
      })
      .withFailureHandler(function(err){
        sending = false;
        retries++;
        renderSync();
        if (err && /BAD_CODE/.test(err.message || '')) {
          say('Access code changed', 'Your counts are safe on this phone. Reload and enter the new code to send them.');
          return;
        }
        // Back off, but never past a minute — the counter is still working.
        clearTimeout(retryTimer);
        retryTimer = setTimeout(flush, Math.min(60000, 2000 * Math.pow(2, Math.min(retries, 5))));
      })
      .rpcSubmit(state.code, batch);
  }

  // ---- status ------------------------------------------------------------
  function ago(ms){
    if (!ms) return 'not yet';
    var m = Math.round((Date.now() - ms) / 60000);
    return m < 1 ? 'just now' : (m === 1 ? '1 min ago' : m + ' min ago');
  }
  function renderSync(){
    var el = $('sync'), txt = $('synctxt'), n = queued().length;
    if (!booted) { el.dataset.state = 'pending'; txt.textContent = 'Loading'; return; }
    if (!navigator.onLine) {
      el.dataset.state = 'offline';
      txt.textContent = n ? 'Offline · ' + n + ' held' : 'Offline';
    } else if (sending) {
      el.dataset.state = 'sending'; txt.textContent = 'Sending ' + n + '…';
    } else if (n) {
      el.dataset.state = 'pending'; txt.textContent = n + ' waiting';
    } else {
      el.dataset.state = 'synced'; txt.textContent = 'All sent · ' + ago(state.lastSync);
    }
    $('send').disabled = sending || !n || !navigator.onLine;
  }
  function say(title, body){
    $('banner-title').textContent = title;
    $('banner-body').textContent = body;
    $('banner').hidden = false;
  }

  // ---- list --------------------------------------------------------------
  function countedIn(gi){
    var n = 0;
    for (var i = 0; i < PRODUCTS.length; i++)
      if (PRODUCTS[i].group === GROUPS[gi] && state.counts[PRODUCTS[i].id]) n++;
    return n;
  }
  function totalIn(gi){
    var n = 0;
    for (var i = 0; i < PRODUCTS.length; i++) if (PRODUCTS[i].group === GROUPS[gi]) n++;
    return n;
  }
  function visible(){
    var q = state.query.trim().toLowerCase();
    if (q) {
      return PRODUCTS.filter(function(p){
        return p.name.toLowerCase().indexOf(q) > -1 || p.barcode.indexOf(q) > -1;
      }).slice(0, 120);
    }
    return PRODUCTS.filter(function(p){ return p.group === GROUPS[state.section]; });
  }

  function renderChips(){
    var box = $('chips');
    box.textContent = '';
    GROUPS.forEach(function(name, gi){
      var done = countedIn(gi), tot = totalIn(gi);
      var b = document.createElement('button');
      b.className = 'chip' + (tot && done === tot ? ' done' : '');
      b.type = 'button';
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(gi === state.section && !state.query));
      var s1 = document.createElement('span'); s1.textContent = name;
      var s2 = document.createElement('span'); s2.className = 'n'; s2.textContent = done + '/' + tot;
      b.appendChild(s1); b.appendChild(s2);
      b.addEventListener('click', function(){
        state.section = gi; state.query = '';
        $('search').value = ''; $('clearsearch').hidden = true;
        persist(); renderAll(); window.scrollTo(0, 0);
      });
      box.appendChild(b);
    });
  }

  function clean(v){ return v.replace(/[^0-9]/g, ''); }

  function row(p){
    var c = state.counts[p.id];
    var el = document.createElement('div');
    el.className = 'row' + (c ? ' counted' : '');

    var nm = document.createElement('div');
    nm.className = 'nm'; nm.textContent = p.name;

    var meta = document.createElement('div');
    meta.className = 'meta';
    var bc = document.createElement('span'); bc.textContent = p.barcode;
    var pr = document.createElement('span'); pr.textContent = '$' + (Number(p.price) || 0).toFixed(2);
    meta.appendChild(bc); meta.appendChild(pr);
    if (p.priority === 'A') {
      var f = document.createElement('span'); f.className = 'pri'; f.textContent = 'count first';
      meta.appendChild(f);
    }

    var step = document.createElement('div');
    step.className = 'stepper';
    var minus = document.createElement('button');
    minus.type = 'button'; minus.textContent = '−';
    minus.setAttribute('aria-label', 'One less ' + p.name);
    var qty = document.createElement('input');
    qty.className = 'qty'; qty.id = 'q-' + p.id; qty.type = 'text';
    qty.inputMode = 'numeric'; qty.setAttribute('pattern', '[0-9]*');
    qty.placeholder = '–'; qty.value = c ? c.stock : '';
    qty.setAttribute('aria-label', 'Stock on hand, ' + p.name);
    var plus = document.createElement('button');
    plus.type = 'button'; plus.textContent = '+';
    plus.setAttribute('aria-label', 'One more ' + p.name);
    step.appendChild(minus); step.appendChild(qty); step.appendChild(plus);

    var mm = document.createElement('div');
    mm.className = 'minmax';
    var lmin = document.createElement('label');
    var minI = document.createElement('input');
    minI.type = 'text'; minI.inputMode = 'numeric'; minI.setAttribute('pattern', '[0-9]*');
    minI.id = 'min-' + p.id; minI.setAttribute('aria-label', 'Minimum for ' + p.name);
    lmin.appendChild(document.createTextNode('min ')); lmin.appendChild(minI);
    var lmax = document.createElement('label');
    var maxI = document.createElement('input');
    maxI.type = 'text'; maxI.inputMode = 'numeric'; maxI.setAttribute('pattern', '[0-9]*');
    maxI.id = 'max-' + p.id; maxI.setAttribute('aria-label', 'Maximum for ' + p.name);
    lmax.appendChild(document.createTextNode('max ')); lmax.appendChild(maxI);
    var opt = document.createElement('span'); opt.className = 'opt'; opt.textContent = 'optional';
    mm.appendChild(lmin); mm.appendChild(lmax); mm.appendChild(opt);
    if (c) { minI.value = c.min === '' ? '' : c.min; maxI.value = c.max === '' ? '' : c.max; }

    function commit(stock){
      if (stock === '' || stock === null) {
        delete state.counts[p.id];
        el.classList.remove('counted');
      } else {
        state.counts[p.id] = {stock:Number(stock), min:minI.value, max:maxI.value, at:Date.now()};
        el.classList.add('counted');
      }
      state.outbox[p.id] = {
        stock: stock === '' ? '' : Number(stock),
        min: minI.value, max: maxI.value, at: Date.now()
      };
      persist();
      renderChips(); renderTotals(); renderSync();
    }

    qty.addEventListener('input', function(){ qty.value = clean(qty.value); commit(qty.value); });
    minus.addEventListener('click', function(){
      var v = Math.max(0, (Number(qty.value) || 0) - 1);
      qty.value = String(v); commit(v);
    });
    plus.addEventListener('click', function(){
      var v = (Number(qty.value) || 0) + 1;
      qty.value = String(v); commit(v);
    });
    [minI, maxI].forEach(function(inp){
      inp.addEventListener('input', function(){
        inp.value = clean(inp.value);
        if (qty.value !== '') commit(qty.value);
      });
    });

    el.appendChild(nm); el.appendChild(meta); el.appendChild(step); el.appendChild(mm);
    return el;
  }

  function renderList(){
    var items = visible(), list = $('list');
    list.textContent = '';
    if (!items.length) {
      var e = document.createElement('div');
      e.className = 'empty';
      e.textContent = state.query
        ? 'Nothing matches “' + state.query + '”. Try part of the name, or the barcode.'
        : 'No products in this section.';
      list.appendChild(e);
      return;
    }
    var head = document.createElement('div');
    head.className = 'sechead';
    var h1 = document.createElement('span'), h2 = document.createElement('span');
    h2.className = 'c';
    if (state.query) {
      h1.textContent = 'Search results';
      h2.textContent = items.length + (items.length === 120 ? '+' : '');
    } else {
      h1.textContent = GROUPS[state.section];
      h2.textContent = countedIn(state.section) + '/' + totalIn(state.section) + ' counted';
    }
    head.appendChild(h1); head.appendChild(h2);
    list.appendChild(head);

    var frag = document.createDocumentFragment();
    items.forEach(function(p){ frag.appendChild(row(p)); });
    list.appendChild(frag);
  }

  function renderTotals(){
    var wide = !!state.query;
    var done = wide ? Object.keys(state.counts).length : countedIn(state.section);
    var tot = wide ? PRODUCTS.length : totalIn(state.section);
    $('scope-label').textContent = wide ? 'Whole store' : (GROUPS[state.section] || '');
    $('done').textContent = done;
    $('total').textContent = tot;
    $('trackfill').style.width = (tot ? (done / tot) * 100 : 0) + '%';
    var c = $('list').querySelector('.sechead .c');
    if (c && !state.query) c.textContent = countedIn(state.section) + '/' + totalIn(state.section) + ' counted';
  }

  function renderAll(){ renderChips(); renderList(); renderTotals(); renderSync(); }

  // ---- events ------------------------------------------------------------
  var searchTimer = null;
  $('search').addEventListener('input', function(){
    $('clearsearch').hidden = !this.value;
    clearTimeout(searchTimer);
    var v = this.value;
    searchTimer = setTimeout(function(){
      state.query = v; renderChips(); renderList(); renderTotals();
    }, 140);
  });
  $('clearsearch').addEventListener('click', function(){
    $('search').value = ''; this.hidden = true; state.query = ''; renderAll();
  });
  $('banner-ok').addEventListener('click', function(){ $('banner').hidden = true; });
  $('send').addEventListener('click', function(){ retries = 0; flush(); });

  document.addEventListener('visibilitychange', function(){
    if (document.hidden) { hiddenAt = Date.now(); return; }
    var away = hiddenAt ? Date.now() - hiddenAt : 0;
    if (away > 60000 && queued().length) {
      say('Back after ' + Math.round(away / 60000) + ' minutes',
          'Your count was still here. Sending the ' + queued().length + ' entries that were waiting.');
    }
    retries = 0;
    flush();
  });
  window.addEventListener('online', function(){ retries = 0; flush(); renderSync(); });
  window.addEventListener('offline', renderSync);
  setInterval(flush, FLUSH_EVERY);
  setInterval(function(){ if (!queued().length) renderSync(); }, 30000);

  // ---- boot --------------------------------------------------------------
  var cachedRoster = restore();

  function openApp(){
    $('gate').hidden = true;
    $('app').hidden = false;
    $('whoami').textContent = state.who ? 'Counting as ' + state.who : '';
    booted = true;
    renderAll();
    flush();
  }

  function fail(msg){
    var err = $('gate-err');
    err.textContent = msg;
    err.hidden = false;
    $('start').disabled = false;
    $('start').textContent = 'Start counting';
  }

  $('start').addEventListener('click', function(){
    var who = $('who').value.trim();
    if (!who) { fail('Put your name in first — it goes next to every count you enter.'); return; }
    state.who = who;
    state.code = $('code').value.trim();
    $('gate-err').hidden = true;
    this.disabled = true;
    this.textContent = 'Checking…';

    bootstrap(state.code, function(res){
      loadRoster(res);
      persist();
      openApp();
    }, function(err){
      var m = (err && err.message) || '';
      if (/BAD_CODE/.test(m)) { fail('That code is not right. Ask the manager.'); return; }
      if (cachedRoster && cachedRoster.length) {
        // Offline start: the roster and any counts from last time are on the
        // device, so counting can carry on and send when signal returns.
        loadRoster({products:cachedRoster});
        persist();
        openApp();
        say('Started offline', 'Using the list saved on this phone. Counts will send when you are back in signal.');
        return;
      }
      fail('Could not reach the sheet, and there is no list saved on this phone yet. Try again in signal.');
    });
  });

  // Returning counter: name and code are already known, so go straight in.
  if (state.who) {
    $('who').value = state.who;
    $('code').value = state.code;
  }
  bootstrap(state.code, function(res){
    $('code-label').hidden = !res.needsCode;
    if (state.who && (!res.needsCode || state.code)) {
      loadRoster(res); persist(); openApp();
    }
  }, function(){
    $('code-label').hidden = false;
  });
})();
</script>
</body>
</html>`;
